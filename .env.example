# Runtime settings. Keep real values in an untracked .env or injected environment.
SAP_BASE_URL=
SAP_CLIENT=600
SAP_USERNAME=
SAP_PASSWORD=
SAP_TIMEOUT_SECONDS=30
SAP_VERIFY_TLS=true
SAP_ALLOW_INSECURE_HTTP=false
SAP_LEDGER_PATH=var/sap_runtime/execution_ledger.sqlite3
SAP_PRECHECK_CONFIG=
SAP_EXECUTION_APPROVAL_ID=
# RFC connection settings used by the SAP.Functions COM scripts.
SAP_APPLICATION_SERVER=
SAP_SYSTEM_NUMBER=
